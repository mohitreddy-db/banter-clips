# Base URL of the BanterClips FastAPI backend.
# Local: the uvicorn dev server. Production: the droplet's https domain
# (set this in Vercel → Project → Settings → Environment Variables).
VITE_API_URL=http://localhost:8000

# Supabase Auth (project "banterclips"). The anon key is safe for the browser.
# Real values live in infra/supabase.md (gitignored).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
