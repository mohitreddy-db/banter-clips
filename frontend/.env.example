# ─────────────────────────────────────────────────────────────────────────────
# BanterClips web app — environment
#
# Copy to `.env`. Vite inlines these at BUILD time — restart `npm run dev`
# (or redeploy on Vercel) after changing them. In production these are set in
# Vercel → Project → Settings → Environment Variables, not from this file.
# ─────────────────────────────────────────────────────────────────────────────

# Which API the app talks to. Pick one:
#   local backend (own data, dummy socials):  http://localhost:8000
#   production API (real prod data!):         https://api.banterclips.com
VITE_API_URL=http://localhost:8000

# Supabase Auth (project "banterclips") — real sign-up/sign-in.
# Same values for local and prod; the anon key is safe for browsers.
# If BOTH are left empty, the app falls back to the instant dev magic-link
# (requires the local backend with DEV_MODE=true).
VITE_SUPABASE_URL=https://taphbakizdagamimbhjh.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key — infra/supabase.md>
