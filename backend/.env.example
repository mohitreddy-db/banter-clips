# Local dev — postgres runs in the banterclips-postgres docker container
DATABASE_URL=postgresql+psycopg://banter:banter_dev@localhost:5433/banterclips

# Any long random string; rotate in production
JWT_SECRET=change-me-in-production

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4573

# DEV_MODE=true returns magic-link tokens directly in the API response
# (no email sending). MUST be false in production.
DEV_MODE=true

# Seconds each dummy generation stage takes (7 stages total)
STAGE_SECONDS=1.4

# Public base URL of this API (used to build absolute media URLs)
API_BASE_URL=http://localhost:8000

# Supabase Auth — the backend verifies user access tokens against this project
# and issues its own session JWTs. Values live in infra/supabase.md.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Meta / Instagram Business Login (real BR-13 publishing). Leave empty to use
# the mock connector. IG_REDIRECT_URI must exactly match an OAuth redirect URI
# registered in the Meta app, and must be https (use a cloudflared tunnel in
# dev). Values live in infra/meta.md.
META_APP_ID=
META_APP_SECRET=
IG_REDIRECT_URI=
FRONTEND_URL=http://localhost:5173

# Only needed for the real pipeline (app/pipeline/) later
OPENAI_API_KEY=
