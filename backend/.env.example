# ─────────────────────────────────────────────────────────────────────────────
# BanterClips API — environment
#
# Copy to `.env` and adjust. The values below are the LOCAL DEV defaults and
# work out of the box. Where prod differs, the prod shape is shown commented
# underneath. Real production secrets are NEVER committed — they live in
# `/opt/banter-clips/backend/.env` on the droplet and in `infra/` locally.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# local: postgres 16 in the `banterclips-postgres` docker container (:5433)
# prod:  Supabase Postgres (password → infra/supabase.md)
DATABASE_URL=postgresql+psycopg://banter:banter_dev@localhost:5433/banterclips
# DATABASE_URL=postgresql+psycopg://postgres:<db-password>@db.taphbakizdagamimbhjh.supabase.co:5432/postgres

# ── Sessions ────────────────────────────────────────────────────────────────
# Signs the API's 30-day session JWTs. Any string locally; long random in prod
# (openssl rand -hex 32). Rotating it signs everyone out.
JWT_SECRET=dev-only-secret

# ── CORS ────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:4573
# CORS_ORIGINS=https://banterclips.com,https://www.banterclips.com,http://localhost:5173

# ── Dev mode ────────────────────────────────────────────────────────────────
# true  → /auth/request-link returns the magic-link token in the response
#         (sign in with any email, no mailbox). MUST be false in prod.
DEV_MODE=true

# ── Dummy generation pacing ─────────────────────────────────────────────────
# Seconds per stage (7 stages). Purely cosmetic until the real pipeline lands.
STAGE_SECONDS=1.4

# ── Public URL of this API ──────────────────────────────────────────────────
# Used to build clip video URLs; Instagram fetches videos from here, so in
# prod it must be the public https domain.
API_BASE_URL=http://localhost:8000
# API_BASE_URL=https://api.banterclips.com

# ── Supabase Auth ───────────────────────────────────────────────────────────
# The backend verifies user access tokens against this project and issues its
# own session JWT. Same values locally and in prod (anon key is browser-safe).
SUPABASE_URL=https://taphbakizdagamimbhjh.supabase.co
SUPABASE_ANON_KEY=<anon key — infra/supabase.md>

# ── Stripe (BR-15 Creator plan) ────────────────────────────────────────────
# Empty → /billing/upgrade acts as a dev mock. With keys set, upgrades run
# through Stripe Checkout and webhooks drive plan state. Keys → infra/stripe.md.
# Webhook endpoint to register in Stripe: {API_BASE_URL}/billing/webhook
# (events: checkout.session.completed, customer.subscription.*)
STRIPE_SECRET_KEY=
STRIPE_PRICE_CREATOR=
STRIPE_WEBHOOK_SECRET=

# ── Meta / Instagram Business Login (BR-13) ────────────────────────────────
# Empty → the mock connector is used (fine for most local work).
# For REAL Instagram locally you need an https tunnel:
#   cloudflared tunnel --url http://localhost:8000
# then set IG_REDIRECT_URI (and API_BASE_URL) to the tunnel URL and register
# the redirect URI in the Meta app. Creds → infra/meta.md.
META_APP_ID=
META_APP_SECRET=
IG_REDIRECT_URI=
# IG_REDIRECT_URI=https://api.banterclips.com/socials/instagram/callback

# ── TikTok Login Kit + Content Posting (BR-13) ──────────────────────────────
# Empty → the mock connector is used. Same https-tunnel dance as Instagram
# for local REAL testing; register the redirect URI in the TikTok app.
# Sandbox note: the TikTok account you log in with must be added as a
# target user in the sandbox settings, and posts land as private (see
# TIKTOK_UNAUDITED in app/config.py).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# TIKTOK_REDIRECT_URI=https://api.banterclips.com/socials/tiktok/callback
# Optional US forward proxy for TikTok API traffic (TikTok is ISP-blocked in
# India). tinyproxy on the NYC droplet; creds → infra/tiktok.md.
TIKTOK_PROXY_URL=
# TIKTOK_PROXY_URL=http://banter:<password>@146.190.213.29:8899

# ── Where OAuth flows return the browser ────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://www.banterclips.com

# ── Video generation (app/video/) ──────────────────────────────────────────
# "real" = run the workflow (the default — free and offline while the
# providers below are "stub"; it only spends once they are "openrouter").
# "mock" = walk the REAL step sequence at real pacing, emitting the same live
# progress lines, but generate nothing — for reviewing the flow.
# "dummy" = walk the stages on a timer and attach the pre-rendered demo clip.
# Whatever this is set to, a take containing [mock] always runs the mock flow
# — that marker is the one intended way to demo without generating.
PIPELINE_MODE=real
# How much faster than real time "mock" runs. 1 = true timings (~4.5 min for
# a 15s clip); 12 = the whole flow in about 20 seconds.
MOCK_SPEED=12

# How generation is dispatched.
#   thread    run it inside the API process. Simple; a deploy mid-render
#             loses the work. Fine for development.
#   postgres  write a job row for a separate worker to pick up. Nothing is
#             lost on deploy or crash, and renders stop competing with
#             request handling for CPU. Use this in production, and run:
#                 systemctl enable --now banterclips-worker
QUEUE_MODE=thread

# Planning + keyframe review (text in / text out). Without a key the planner
# falls back to a deterministic template and review is skipped — a job still
# produces a video, just a less interesting one. Script quality comes from the
# plan model — keep it on a capable model (gpt-4.1 or gpt-5); the reviewer
# only fills a yes/no rubric on an image, so a cheap vision model is enough.
OPENAI_API_KEY=
OPENAI_PLAN_MODEL=gpt-4.1
OPENAI_REVIEW_MODEL=gpt-4o-mini

# Optional web research for off-catalog cast ("off" | "openai"). With
# "openai", casting someone unknown triggers ONE web-search call to write a
# real look description before any image money is spent. Never fatal.
# A shot-writer pass writes the video prompt as cinematography prose (one
# call per job). "off" uses the deterministic template instead; guardrails
# are appended either way.
SHOT_WRITER=openai

WEB_RESEARCH=openai
OPENAI_RESEARCH_MODEL=gpt-4.1-mini

# Images and video. Both default to offline stubs, so the pipeline runs end to
# end with no key and no spend. Set a provider to "openrouter" to go live.
#   IMAGE_PROVIDER=openrouter  → real keyframes, ~$0.05 each
#   VIDEO_PROVIDER=openrouter  → real animation, ~$0.14/second at 720p
# With VIDEO_PROVIDER=stub the approved keyframe is animated locally with a
# slow push-in, which is also the fallback when a real animation fails.
OPENROUTER_API_KEY=
IMAGE_PROVIDER=stub
IMAGE_MODEL=x-ai/grok-imagine-image-quality
VIDEO_PROVIDER=stub
VIDEO_MODEL=x-ai/grok-imagine-video-1.5
VIDEO_RESOLUTION=720p

# Hard ceiling per job. Cost scales with duration, so a runaway plan is
# expensive; the pipeline degrades to stills rather than exceeding this.
MAX_JOB_COST_USD=8.0

# ── Artifact storage ────────────────────────────────────────────────────────
# "local" writes under data/media and serves from /media — fine for dev and a
# single box. "supabase" uploads to Supabase Storage (no new vendor: auth
# already uses it). Keys are users/{user_id}/clips/{clip_id}/final.mp4.
# The final MP4 must be publicly readable — Instagram fetches it by URL and
# cannot present credentials — so unguessable keys are the protection.
STORAGE_BACKEND=local
STORAGE_BUCKET=clips
# Service-role key (server only, never sent to a browser). Uploads and deletes
# need it; the anon key cannot do either. → infra/supabase.md
SUPABASE_SERVICE_ROLE_KEY=

# Working files (per-scene clips, rejected keyframes, the pre-branding cut) are
# deleted after this many days by `python -m app.services.housekeeping`.
# Measured per 15s clip: ~14 MB worth keeping, ~38 MB scratch.
SCRATCH_RETENTION_DAYS=7

# ── Demo markers ────────────────────────────────────────────────────────────
# Put [mock] in a take to simulate a whole run — real stages, real pacing,
# nothing generated — even when PIPELINE_MODE=real. [fail] forces the failure
# state. Both are stripped from the stored take, consume no allowance, and
# produce clips that cannot be published.

# Comma-separated emails allowed into the admin panel (/admin — catalog
# management). Everyone else gets 404s, and the nav link stays hidden.
ADMIN_EMAILS=
