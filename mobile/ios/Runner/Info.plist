<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>BanterClips</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>banterclips</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Portrait only. Every screen is a vertical column and the product is a
	     9:16 video; a landscape layout would be a second design to maintain
	     for an orientation nobody watches Reels in. Matches the
	     SystemChrome call in main.dart. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- Custom schemes the app answers to.
	     banterclips://login-callback  — Supabase (Google, magic link, confirm)
	     banterclips://reset-password  — Supabase password recovery
	     banterclips://oauth/instagram — Instagram Business Login return -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.banterclips.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>banterclips</string>
			</array>
		</dict>
	</array>

	<!-- Written as a human sentence on purpose: Apple rejects missing or lazy
	     usage strings, and this one is shown verbatim when someone saves a
	     finished clip out of the share sheet. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>BanterClips needs permission to save your finished videos to your photo library, so you can post them anywhere you like.</string>

	<!-- The dark theme is the only theme; without this iOS draws light status
	     bar text on a light background in some transitions. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
